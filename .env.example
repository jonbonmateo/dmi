# ---------------------------------------------------------------------------
# DMI — environment
#
# EVERY variable here is optional. With none of them set, the app runs on a
# local JSON store with fixture-backed providers and a full end-to-end demo.
# Each credential you add turns one more component from mocked to live; the
# /api/health endpoint always tells you which is which.
# ---------------------------------------------------------------------------

# Public base URL. Used to build the DMI link stored in the tracking sheet,
# so it must be the real deployment URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication --------------------------------------------------------
# REQUIRED IN PRODUCTION. Signs the session cookie; the app refuses to boot
# without it when NODE_ENV=production. Generate: openssl rand -base64 48
AUTH_SECRET=

# Google Sign-In. Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application. Add this authorised redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional comma-separated allow-list. With a value set, only these email
# domains may sign up or sign in with Google.
# e.g. AUTH_ALLOWED_DOMAINS=shopmarketingpros.com
AUTH_ALLOWED_DOMAINS=

# Guest sign-in (read-only, pinned to mock mode). Set to 0 to disable.
AUTH_ALLOW_GUEST=1
# Self-service sign-up. Set to 0 once the team's accounts exist.
AUTH_ALLOW_SIGNUP=1

# Password-reset email. resend.com -> API key. Without it, reset links are
# written to the server log instead of emailed (see DMI_DEV_RESET_LINKS below).
RESEND_API_KEY=
EMAIL_FROM=

# DANGER — leave unset in any deployment reachable by untrusted users.
# 1 = when no RESEND_API_KEY is set, /api/auth/forgot returns the reset link
# directly in its response instead of only logging it. That response goes to
# whoever CALLS the endpoint, not necessarily the account owner, so turning
# this on anywhere but a private local/test instance makes "forgot password"
# an account-takeover oracle for any email address an attacker guesses.
DMI_DEV_RESET_LINKS=

# --- Supabase (database) ---------------------------------------------------
# Set BOTH to switch from the local JSON store to Postgres.
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google PageSpeed Insights (website performance) -----------------------
# Works without a key at a low rate limit; the key raises it.
# console.cloud.google.com → enable "PageSpeed Insights API" → create API key.
PAGESPEED_API_KEY=

# --- Google Places API, New (business verification + Google Business Profile)
# console.cloud.google.com → enable "Places API (New)" → create API key.
# Without it, verification and the GBP criterion fall back to fixtures/manual.
GOOGLE_MAPS_API_KEY=

# --- Meta Ad Library (Facebook/Instagram advertising) ----------------------
# developers.facebook.com → app → Marketing API → app access token.
META_AD_LIBRARY_TOKEN=

# --- GoHighLevel -----------------------------------------------------------
# Private Integration token with contacts.write and contacts/notes.write.
GHL_API_KEY=
GHL_LOCATION_ID=

# --- Zapier catch hooks ----------------------------------------------------
# Tracking spreadsheet mirror and Ads Budget Card creation.
ZAPIER_TRACKING_WEBHOOK_URL=
ZAPIER_ADS_BUDGET_CARD_WEBHOOK_URL=

# --- Security --------------------------------------------------------------
# Shared secret Zapier must send as the x-dmi-secret header on /api/intake.
# Unset = the endpoint is open (fine locally, not in production).
DMI_INTAKE_SECRET=
# Vercel sets this itself when you add a cron; match it here to reject
# unauthenticated calls to /api/cron.
CRON_SECRET=

# --- Local development toggles ---------------------------------------------
# Mode is normally chosen per session at sign-in. This variable only sets the
# default for CLI scripts and tests, which have no session.
# 1 = every provider (including the web crawler) reads from fixtures/.
DMI_FORCE_MOCK=
# Where the local JSON store writes when Supabase is not configured.
DMI_DATA_DIR=.data
# debug | info | warn | error
DMI_LOG_LEVEL=info
